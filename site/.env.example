NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only this email can log in (server-side check, no code is sent to anyone else)
ALLOWED_EMAIL=adarshbharathwaj13@gmail.com
# Read-only token for machine routes (llms.txt, .md, /api/refs.json). Rotated in milestone 7.
HUB_READ_TOKEN=

# Local worker + `pnpm sync` (repo root .env.local). Limited hub_worker role; set its password in the Supabase SQL editor.
HUB_DATABASE_URL=

# Worker storage (repo root .env.local). Supabase dashboard → Storage → S3 Connection → New access key.
# This key only reaches Storage; it cannot read or change the database.
HUB_S3_ENDPOINT=
HUB_S3_REGION=
HUB_S3_ACCESS_KEY_ID=
HUB_S3_SECRET_ACCESS_KEY=

# Reddit script app (reddit.com/prefs/apps → create app → type "script"). Optional: Reddit clips fall back to yt-dlp.
HUB_REDDIT_CLIENT_ID=
HUB_REDDIT_CLIENT_SECRET=
HUB_REDDIT_USERNAME=
HUB_REDDIT_PASSWORD=
